# Copy this file to .env; keep API keys private. Existing environment wins.
# rules = deterministic local command router (not an LLM)
# openai = cloud Responses API; sends text/tool outputs; separate API charges
# ollama = local Ollama LLM; requires an installed model with tool support
AGENT_PROVIDER=rules

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Local multilingual model, CPU int8. Prepared weights live in models/base.
WHISPER_MODEL=base
# Optional absolute directory containing model.bin/config.json/tokenizer.json.
LOCAL_WHISPER_MODEL=
# Default 0: never download automatically. 1 permits first-use model download.
WHISPER_ALLOW_DOWNLOAD=0
